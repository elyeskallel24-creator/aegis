# AEGIS Environment Variables
# Copy this file to .env and customize as needed

# Environment settings
AEGIS_ENV=development
AEGIS_DEBUG=false
AEGIS_LOG_LEVEL=INFO

# API server settings
AEGIS_API_HOST=127.0.0.1
AEGIS_API_PORT=8000

# Concurrency limits
AEGIS_MAX_CONCURRENT_AI_CALLS=2
AEGIS_MAX_CONCURRENT_TOOL_CALLS=5
